# ===================================
# VisaCanada - Environment Variables
# ===================================

# Application
APP_NAME=VisaCanada
APP_ENV=development
DEBUG=true

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=visacanada
POSTGRES_USER=visacanada
POSTGRES_PASSWORD=visacanada_dev_password
DATABASE_URL=postgresql+asyncpg://visacanada:visacanada_dev_password@localhost:5432/visacanada

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AWS S3 (Document Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1
S3_BUCKET_NAME=visacanada-documents

# Azure Document Intelligence (OCR)
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# Claude API (Anthropic)
ANTHROPIC_API_KEY=

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Email Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
